# Backend Environment Variables
# Copy to .env.local or set as environment variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string (override individual parts above if needed)
# DefaultConnection=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=yourpassword

# JWT
JWT_SECRET=your-minimum-32-character-secret-key-here
JWT_ISSUER=swovnai
JWT_AUDIENCE=swovnai

# Gateway Mode
#   Local   - use GatewayAuthMiddleware (calls AuthModule /api/gatekeeper)
#   APIM    - skip GatewayAuthMiddleware, let APIM handle auth
GATEWAY_MODE=Local

# AuthModule URL (for LocalGateway when GATEWAY_MODE=Local)
AUTH_MODULE_URL=http://localhost:5001

# Logging
LOGGING_LEVEL=Information
