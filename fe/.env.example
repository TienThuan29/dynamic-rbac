# Frontend Environment Variables
# Copy to .env.local and fill in values

# API base URLs (used by axios in fe/src/api/api.ts)
# For local dev: defaults to /api (proxied via vite.config.ts to localhost:5000)
# For production: set to the full URL of your gateway
VITE_MAIN_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/api
